// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FARMER
  USER
}

enum Action {
  VIEW
  DELETE
  CREATE
  UPDATE
}

enum Visibility {
  PUBLIC
  SUMMARY_ONLY
  RESTRICTED
}

enum WeatherCondition {
  SUNNY
  CLOUDY
  RAINY
  SNOWY
  WINDY
  FOGGY
}

// ============================================
// User & Auth
// ============================================
model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  tel   String?
  role  Role   @default(USER)
  avatar File?  @relation(fields: [fileId], references: [id])
  fileId String?
  password Password?

  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizations           Organization[] @relation("Organization")
  ownedOrganizations      Organization[] @relation("OwnedOrganization")
  accessLogs              AccessLog[]
  knowhows                Knowhow[]
  ndaAgreementsAsProvider NdaAgreement[] @relation("Provider")
  ndaAgreementsAsLearner  NdaAgreement[] @relation("Learner")
  farms                   Farm[]
  workLogs                WorkLog[]
  interestTags            InterestTag[]
  accessibleKnowhows      Knowhow[]      @relation("KnowhowAccess")
  
  // Board & Like
  posts Post[]
  likes Like[]
}

model Password {
  hash   String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model InterestTag {
  id       String    @id @default(cuid())
  tag      String    @unique
  users    User[]
  knowhows Knowhow[]
}

model Organization {
  id     String  @id @default(cuid())
  name   String
  detail String?

  owners User[] @relation("OwnedOrganization")
  users  User[] @relation("Organization")
}

model Crop {
  id   Int    @id @default(autoincrement())
  name String @unique
  Farm Farm[]
}

model Farm {
  id               Int    @id @default(autoincrement())
  name             String
  region           String
  areaHa           Float
  seasonalCalendar String

  users          User[]
  knowhows       Knowhow[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  workLogs       WorkLog[]
  mainCrop       Crop           @relation(fields: [cropId], references: [id])
  cropId         Int
  organizationId String?

  @@index([cropId])
}

model Knowhow {
  id       Int     @id @default(autoincrement())
  title    String
  summary  String?
  fullText String?

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  farmId     Int
  userId     String
  visibility Visibility

  farm            Farm          @relation(fields: [farmId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  accessibleUsers User[]        @relation("KnowhowAccess")
  accessLogs      AccessLog[]
  tags            InterestTag[]

  @@index([farmId])
  @@index([userId])
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  action    Action
  timestamp DateTime @default(now())
  knowhowId Int
  userId    String

  knowhow Knowhow @relation(fields: [knowhowId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([knowhowId])
  @@index([userId])
}

model NdaAgreement {
  id         Int      @id @default(autoincrement())
  providerId String
  learnerId  String
  ndaHash    String
  expiry     DateTime

  provider User @relation("Provider", fields: [providerId], references: [id])
  learner  User @relation("Learner", fields: [learnerId], references: [id])

  @@index([providerId])
  @@index([learnerId])
}

model WorkLog {
  id            Int               @id @default(autoincrement())
  date          DateTime
  workDetails   String
  weather       WeatherCondition?
  temperature   Float?
  humidity      Float?
  windSpeed     Float?
  precipitation Float?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  title         String            @default("作業日誌")

  farmId Int
  farm   Farm   @relation(fields: [farmId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  files File[]
  tags  InterestTag[] @relation("WorkLogTags")

  @@index([farmId])
  @@index([userId])
  @@index([date])
}

model File {
  id       String  @id @default(cuid())
  url      String
  fileName String
  mimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowhows Knowhow[]
  users    User[]
  workLogs WorkLog[]
}

// ============================================
// Board & Like
// ============================================
model Post {
  id        String @id @default(cuid())
  title     String
  content   String
  author    User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String

  likes     Like[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model Like {
  id        String @id @default(cuid())
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}