// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FARMER
  USER
}

enum Action {
  VIEW
  DELETE
  CREATE
  UPDATE
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  tel       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(USER)
  avatar    File?    @relation(fields: [fileId], references: [id])

  fileId                  String?
  password                Password?
  organizations           Organization[] @relation("Organization")
  ownedOrganizations      Organization[] @relation("OwnedOrganization")
  accessLogs              AccessLog[]
  knowhows                Knowhow[]
  ndaAgreementsAsProvider NdaAgreement[] @relation("Provider")
  ndaAgreementsAsLearner  NdaAgreement[] @relation("Learner")
  Farm                    Farm[]
  WorkLog                 WorkLog[]
  InterestTag             InterestTag[]
  accessibleKnowhows      Knowhow[]      @relation("KnowhowAccess")
}

model Password {
  hash   String
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model InterestTag {
  id       String    @id @default(cuid())
  tag      String    @unique
  users    User[]
  knowhows Knowhow[]
}

model Organization {
  id     String  @id @default(cuid())
  name   String
  detail String?

  owners User[] @relation("OwnedOrganization")
  users  User[] @relation("Organization")
}

model Crop {
  id   Int    @id @default(autoincrement())
  name String @unique
  Farm Farm[]
}

model Farm {
  id               Int    @id @default(autoincrement())
  name             String
  region           String
  areaHa           Float
  seasonalCalendar String

  users    User[]
  knowhows Knowhow[]
  WorkLogs WorkLog[]
  mainCrop Crop      @relation(fields: [cropId], references: [id])
  cropId   Int

  @@index([cropId])
}

enum Visibility {
  PUBLIC
  SUMMARY_ONLY
  RESTRICTED
}

model Knowhow {
  id       Int     @id @default(autoincrement())
  title    String
  summary  String?
  fullText String?
  cover    File?   @relation(fields: [fileId], references: [id])

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  farmId     Int
  userId     String
  visibility Visibility

  fileId          String?
  farm            Farm          @relation(fields: [farmId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  accessibleUsers User[]        @relation("KnowhowAccess")
  accessLogs      AccessLog[]
  tags            InterestTag[]

  @@index([farmId])
  @@index([userId])
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  action    Action
  timestamp DateTime @default(now())
  knowhowId Int
  userId    String

  knowhow Knowhow @relation(fields: [knowhowId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([knowhowId])
  @@index([userId])
}

model NdaAgreement {
  id         Int      @id @default(autoincrement())
  providerId String
  learnerId  String
  ndaHash    String
  expiry     DateTime

  provider User @relation("Provider", fields: [providerId], references: [id])
  learner  User @relation("Learner", fields: [learnerId], references: [id])

  @@index([providerId])
  @@index([learnerId])
}

enum WeatherCondition {
  SUNNY
  CLOUDY
  RAINY
  SNOWY
  WINDY
  FOGGY
}

model WorkLog {
  id            Int               @id @default(autoincrement())
  date          DateTime
  workDetails   String
  weather       WeatherCondition?
  temperature   Float?
  humidity      Float?
  windSpeed     Float?
  precipitation Float?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  files         File[]

  farmId Int
  farm   Farm   @relation(fields: [farmId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([farmId])
  @@index([userId])
  @@index([date])
}

model File {
  id       String  @id @default(cuid())
  url      String
  fileName String
  mimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowhows Knowhow[]
  users    User[]
  worklogs WorkLog[]
}
